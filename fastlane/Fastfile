# Fastfile — Mople iOS 빌드/배포 자동화
#
# 사용법:
#   fastlane beta                              → Mople Dev를 TestFlight에 업로드 (테스트 배포)
#   fastlane release                           → Mople을 App Store에 업로드 (출시)
#   fastlane deploy_release                    → develop → release 머지 + 태그 + App Store 업로드
#   fastlane deploy_release submit:true        → 위 + 심사 자동 제출
#   fastlane deploy_release changelog:"내용"   → 릴리즈 노트 포함
#   fastlane build_only                        → 빌드만 (업로드 X, 빌드 검증용)
#
# 필요 조건:
#   - App Store Connect API Key (p8 파일)
#   - 프로비저닝 프로파일 로컬 설치 완료
#   - Xcode 설치

default_platform(:ios)

# ──────────────────────────────────────────────
# App Store Connect API Key 설정
# Apple ID/패스워드 대신 API Key로 인증
# → 2FA 없이 자동화 가능, CI/CD 필수
# ──────────────────────────────────────────────
API_KEY = app_store_connect_api_key(
  key_id: "4AD2MCFFH2",
  issuer_id: "077a4d64-9ada-4316-9cf8-45e9b944ba64",
  key_filepath: File.join(Dir.home, "Desktop/Task/Develop/Swift/CICD/Release/AuthKey_4AD2MCFFH2.p8"),
  in_house: false
)

platform :ios do

  # ──────────────────────────────────────────
  # beta: Mople Dev → TestFlight (테스트 배포)
  # ──────────────────────────────────────────
  desc "Mople Dev를 TestFlight에 업로드 (테스트용)"
  lane :beta do |options|
    # 1) 빌드번호 자동 증가
    notification(title: "📦 TestFlight", message: "[1/3] 빌드번호 확인 중...")
    increment_build_number(
      build_number: latest_testflight_build_number(
        api_key: API_KEY,
        app_identifier: "com.moim.moimtable.dev"
      ) + 1
    )

    # 2) Mople Dev 빌드 (Tuist 전환 후: 단일 "Mople" 스킴 + Debug = Dev 서버)
    notification(title: "📦 TestFlight", message: "[2/3] 빌드 시작... (약 2~3분)")
    build_app(
      workspace: "Mople.xcworkspace",
      scheme: "Mople",
      configuration: "Debug",
      clean: true,
      export_method: "app-store",
      cloned_source_packages_path: "SourcePackages",
      xcargs: "ENABLE_USER_SCRIPT_SANDBOXING=NO",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.moim.moimtable.dev" => "MopleDev Distribution"
        }
      }
    )

    # 3) TestFlight 업로드
    notification(title: "📦 TestFlight", message: "[3/3] 업로드 중... (약 3~4분)")
    upload_to_testflight(
      api_key: API_KEY,
      app_identifier: "com.moim.moimtable.dev",
      skip_waiting_for_build_processing: true,
      changelog: options[:changelog] || "버그 수정 및 기능 개선"
    )

    # 완료 알림
    notification(
      title: "🚀 TestFlight 업로드 완료!",
      message: "Mople Dev #{get_version_number(xcodeproj: 'Mople.xcodeproj', target: 'Mople')} 업로드 성공!"
    )

    UI.success("TestFlight 업로드 완료! (Mople Dev)")
  end

  # ──────────────────────────────────────────
  # release: Mople → App Store (출시)
  # ──────────────────────────────────────────
  desc "Mople을 App Store에 업로드 (출시용)"
  lane :release do
    # 1) 빌드번호 자동 증가
    increment_build_number(
      build_number: app_store_build_number(
        api_key: API_KEY,
        app_identifier: "com.moim.moimtable"
      ) + 1
    )

    # 2) Mople 프로덕션 스킴으로 빌드 (Release 설정)
    build_app(
      workspace: "Mople.xcworkspace",
      scheme: "Mople",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      cloned_source_packages_path: "SourcePackages",
      xcargs: "ENABLE_USER_SCRIPT_SANDBOXING=NO",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.moim.moimtable" => "Mople Distribution"
        }
      }
    )

    # 3) App Store 업로드 (심사 제출은 수동)
    upload_to_app_store(
      api_key: API_KEY,
      app_identifier: "com.moim.moimtable",  # 프로덕션 앱 명시 (Appfile 기본값=dev 방지)
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false
    )

    notification(
      title: "🚀 App Store 업로드 완료",
      message: "Mople #{get_version_number(xcodeproj: 'Mople.xcodeproj', target: 'Mople')} 업로드 성공!"
    )

    UI.success("App Store 업로드 완료! (Mople)")
  end

  # ──────────────────────────────────────────
  # deploy_release: 릴리즈 전체 자동화
  #   develop → release 머지 → 태그 → App Store 업로드
  # ──────────────────────────────────────────
  desc "develop → release 머지 + 태그 + App Store 업로드 (옵션: 심사 제출)"
  lane :deploy_release do |options|
    # 프로젝트에서 현재 마케팅 버전 가져오기
    version = get_version_number(
      xcodeproj: "Mople.xcodeproj",
      target: "Mople"
    )
    release_branch = "release/v#{version}"

    UI.message("🚀 릴리즈 시작: v#{version}")

    # 1) develop 브랜치 최신화
    sh("git checkout develop")
    sh("git pull origin develop")

    # 2) release 브랜치 생성 또는 업데이트
    #    이미 존재하면 develop을 머지, 없으면 새로 생성
    begin
      sh("git checkout #{release_branch}")
      sh("git merge develop --no-edit")
      UI.message("기존 #{release_branch} 브랜치에 develop 머지 완료")
    rescue
      sh("git checkout -b #{release_branch}")
      UI.message("#{release_branch} 브랜치 새로 생성")
    end

    # 3) 태그 생성 (이미 있으면 건너뜀)
    begin
      sh("git tag #{version}")
      UI.message("태그 v#{version} 생성")
    rescue
      UI.message("태그 #{version}이 이미 존재합니다. 건너뜁니다.")
    end

    # 4) release 브랜치 + 태그 push
    sh("git push origin #{release_branch}")
    sh("git push origin #{version} || true")

    # 5) 빌드번호 자동 증가
    increment_build_number(
      build_number: app_store_build_number(
        api_key: API_KEY,
        app_identifier: "com.moim.moimtable"
      ) + 1
    )

    # 6) Mople 프로덕션 빌드
    build_app(
      workspace: "Mople.xcworkspace",
      scheme: "Mople",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      cloned_source_packages_path: "SourcePackages",
      xcargs: "ENABLE_USER_SCRIPT_SANDBOXING=NO",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.moim.moimtable" => "Mople Distribution"
        }
      }
    )

    # 7) App Store 업로드
    submit = options[:submit] == true || options[:submit] == "true"
    changelog = options[:changelog] || "버그 수정 및 기능 개선"

    upload_to_app_store(
      api_key: API_KEY,
      app_identifier: "com.moim.moimtable",  # 프로덕션 앱 명시 (Appfile 기본값=dev 방지)
      force: true,                          # 비대화형 실행: 메타데이터 확인 프롬프트 건너뜀
      skip_metadata: !submit,              # 심사 제출 시에만 메타데이터 포함
      skip_screenshots: true,
      submit_for_review: submit,            # submit:true 시 심사 자동 제출
      precheck_include_in_app_purchases: false,
      release_notes: submit ? { "ko" => changelog } : nil
    )

    # 8) macOS 알림
    if submit
      notification(title: "🚀 릴리즈 완료", message: "Mople v#{version} App Store 업로드 + 심사 제출 완료!")
      UI.success("App Store 업로드 + 심사 제출 완료! (v#{version})")
    else
      notification(title: "🚀 릴리즈 완료", message: "Mople v#{version} App Store 업로드 완료!")
      UI.success("App Store 업로드 완료! 심사 제출은 App Store Connect에서 수동으로. (v#{version})")
    end

    # 8) develop으로 복귀
    sh("git checkout develop")
  end

  # ──────────────────────────────────────────
  # build_only: 빌드 검증만 (업로드 X)
  # ──────────────────────────────────────────
  desc "빌드만 수행 (업로드 없음, PR 검증용)"
  lane :build_only do
    build_app(
      workspace: "Mople.xcworkspace",
      scheme: "Mople",
      configuration: "Debug",
      clean: true,
      export_method: "app-store",
      cloned_source_packages_path: "SourcePackages",
      xcargs: "ENABLE_USER_SCRIPT_SANDBOXING=NO",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.moim.moimtable.dev" => "MopleDev Distribution"
        }
      }
    )

    UI.success("빌드 성공!")
  end

end
